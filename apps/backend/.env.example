# 실행 환경 (development / test / production)
ENVIRONMENT=development

# MongoDB 연결 문자열 (Atlas / 로컬, production 실제 값은 커밋 금지)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mirisalim

# production에서는 개발 기본값과 다른 32자 이상의 난수를 사용
PARTICIPANT_TOKEN_PEPPER=mirisalim_dev_pepper_secret_2026

# 세션과 MongoDB TTL 보존 기간
SESSION_TTL_DAYS=7

# CORS 허용 Origin (쉼표 구분, production에서는 HTTPS Vercel Origin 필수)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
