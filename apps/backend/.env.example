# 실행 환경 (development / test / production)
ENVIRONMENT=development

# MongoDB 연결 문자열 (Atlas / 로컬, production 실제 값은 커밋 금지)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mirisalim

# production에서는 개발 기본값과 다른 32자 이상의 난수를 사용
PARTICIPANT_TOKEN_PEPPER=mirisalim_dev_pepper_secret_2026

# 세션과 MongoDB TTL 보존 기간
SESSION_TTL_DAYS=7

# CORS 허용 Origin (쉼표 구분, production에서는 HTTPS Vercel Origin 필수)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Deep is opt-in; keep disabled until the whole Deep release gate is verified.
DEEP_MODE_ENABLED=false
# Browser-facing same-origin /api proxy. No trailing slash or path.
# Register exactly PUBLIC_APP_ORIGIN + /api/v1/auth/kakao/callback in Kakao.
PUBLIC_APP_ORIGIN=http://localhost:3000
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Set false while configuring reviewer-only login; does not change Kakao Developers settings.
KAKAO_LOGIN_ENABLED=true
# Enable only for judging, with two independently generated password hashes.
REVIEWER_LOGIN_ENABLED=false
# Generate with: python scripts/reviewer_password.py a (and b). Never store plaintext here.
REVIEWER_A_PASSWORD_HASH=
REVIEWER_B_PASSWORD_HASH=
# Independent random secret, at least 32 characters. Never expose to frontend JS.
AUTH_SESSION_PEPPER=
# Proposed retention; confirm before release. Allowed range: 1..365 days.
DEEP_DRAFT_TTL_DAYS=30
DEEP_REPORT_TTL_DAYS=90

# AI explanation: keep disabled until synthetic-output evaluation is approved.
# Backend-only secret; never put this in VITE_ / NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
DEEP_MEETING_AI_ENABLED=false
# UTC daily conservative reservation limit: 250000 micro-USD = $0.25, excluding taxes.
DEEP_MEETING_AI_DAILY_MICRO_USD=250000
DEEP_MEETING_AI_DAILY_CALLS=20
